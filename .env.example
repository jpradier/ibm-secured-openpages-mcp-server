# GRC MCP Server Configuration
#
# Quick Start:
#   - For Basic Auth (on-premises or IBM Cloud Hosted): set OPENPAGES_AUTHENTICATION_TYPE=basic
#   - For Bearer Auth (IBM Cloud SaaS, MCSP, or CP4D): set OPENPAGES_AUTHENTICATION_TYPE=bearer
#   - For detailed comments on all options: See .env.example.full

# ============================================================================
# MANDATORY SETTINGS
# ============================================================================

# OpenPages Connection
OPENPAGES_BASE_URL=https://your-openpages-instance.com
OPENPAGES_AUTHENTICATION_TYPE=basic

# Basic Auth (required if OPENPAGES_AUTHENTICATION_TYPE=basic)
OPENPAGES_USERNAME=
OPENPAGES_PASSWORD=

# Bearer Auth (required if OPENPAGES_AUTHENTICATION_TYPE=bearer)
OPENPAGES_AUTHENTICATION_URL=
OPENPAGES_APIKEY=

# MCP Server Authentication
# Static bearer token to protect the MCP endpoint.
# ALL requests must include "Authorization: Bearer <token>".
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_TOKEN=

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Server
APP_NAME=grc-mcp-server
DEBUG=false
ENVIRONMENT=production
SERVER_MODE=remote
HOST=0.0.0.0
PORT=8000

# SSL
SSL_VERIFY=true

# Auth posture:
#   "server" — MCP server uses its own credentials for all tool calls (on-prem / local / dev)
#   "user"   — per-user auth framework enforced (multi-tenant SaaS)
OPENPAGES_AUTH_MODE=server

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/grc-mcp.log

# Observability (optional)
OBSERVABILITY_ENABLED=false
METRICS_ENABLED=false
TRACING_ENABLED=false

# Object Types
OBJECT_TYPES_CONFIG_PATH=src/app/config/object_types.json

# Schema Caching
SCHEMA_CACHE_MAX_SIZE=200
SCHEMA_CACHE_TTL=3600
ENABLE_MINIMAL_SCHEMA_MODE=true
